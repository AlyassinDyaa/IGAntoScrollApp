# ---------------------------------------------------------------------------
# IG Focus Hub - environment template
# Copy to .env (root) and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- App URLs ---------------------------------------------------------------
# On Render/Railway API_URL is derived from the platform's public URL when omitted.
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Mode -------------------------------------------------------------------
# When MOCK_META=1 the API serves fixture data and never calls Meta.
# This lets the whole app run before the Meta app review is complete.
MOCK_META=1

# --- Database / queue -------------------------------------------------------
DATABASE_URL=postgresql://igfocus:igfocus@localhost:5432/igfocus?schema=public
REDIS_URL=redis://localhost:6379

# --- Security ---------------------------------------------------------------
# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Random string used to sign the app session cookie.
SESSION_SECRET=

# --- Meta (Facebook Login for Instagram Platform) ---------------------------
# Create at https://developers.facebook.com/apps -> "Business" app type.
# Each Instagram professional account must be linked to a Facebook Page.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
META_REDIRECT_URI=http://localhost:4000/auth/meta/callback
# Random token you choose; paste the same value in the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=

# --- Web Push (VAPID) -------------------------------------------------------
# Generate once: pnpm --filter @ig-focus-hub/api vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
