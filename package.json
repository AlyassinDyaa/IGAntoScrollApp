{
  "name": "ig-focus-hub",
  "private": true,
  "version": "0.1.0",
  "description": "IG Focus Hub - Instagram without the doomscrolling. A focused companion app for messaging, publishing and business tools across up to three professional Instagram accounts.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @ig-focus-hub/web dev",
    "dev:api": "pnpm --filter @ig-focus-hub/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @ig-focus-hub/db generate",
    "db:migrate": "pnpm --filter @ig-focus-hub/db migrate",
    "db:studio": "pnpm --filter @ig-focus-hub/db studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "msgpackr-extract",
      "unrs-resolver",
      "sharp"
    ]
  }
}
